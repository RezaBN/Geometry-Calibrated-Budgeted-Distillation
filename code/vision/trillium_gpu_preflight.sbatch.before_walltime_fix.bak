#!/bin/bash
#SBATCH --account=def-koohi
#SBATCH --job-name=gcbd-trillium-preflight
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=24
#SBATCH --time=00:05:00
#SBATCH --output=logs/%x-%j.out
#SBATCH --mail-type=FAIL

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
if [[ -z "${SCRATCH:-}" ]]; then
  echo "SCRATCH is not defined. This preflight is intended for Trillium." >&2
  exit 2
fi
ROOT=${GCBD_VISION_ROOT:-$SCRATCH/gcbd-vision}
VENV=${GCBD_VISION_VENV:-$ROOT/env/venv}

module --force purge
module load StdEnv/2023
module load cuda/12.6
module load python/3.11.5
source "$VENV/bin/activate"

export TORCH_HOME=${GCBD_VISION_TORCH_HOME:-$ROOT/cache/torch}
export HF_HUB_OFFLINE=1
export TRANSFORMERS_OFFLINE=1
export HF_DATASETS_OFFLINE=1
export PYTHONPATH="$SCRIPT_DIR${PYTHONPATH:+:$PYTHONPATH}"

cd "$SCRIPT_DIR"

echo "Host: $(hostname)"
echo "Job: ${SLURM_JOB_ID:-unknown}"
echo "CPUs: ${SLURM_CPUS_PER_TASK:-unset}"
nvidia-smi -L

python - <<'PY'
import torch
import torchvision
import timm
from gcbd_vision.config import SCENARIOS
from gcbd_vision.models import FeatureModel, create_model, layer_names

print("torch:", torch.__version__)
print("torchvision:", torchvision.__version__)
print("timm:", timm.__version__)
print("torch CUDA runtime:", torch.version.cuda)
print("CUDA available:", torch.cuda.is_available())
assert torch.cuda.is_available(), "PyTorch cannot see the allocated H100"
print("GPU:", torch.cuda.get_device_name(0))
print("BF16 supported:", torch.cuda.is_bf16_supported())
assert torch.cuda.is_bf16_supported(), "Expected BF16 support on H100"

device = torch.device("cuda", 0)
seen = sorted({spec["student"] for spec in SCENARIOS.values()})
for arch in seen:
    model = FeatureModel(create_model(arch, 1000), layer_names(arch)).eval().to(device)
    with torch.inference_mode(), torch.autocast(device_type="cuda", dtype=torch.bfloat16):
        logits, features = model(torch.zeros(1, 3, 224, 224, device=device))
    assert tuple(logits.shape) == (1, 1000), (arch, logits.shape)
    assert len(features) == len(layer_names(arch)), arch
    print(f"GPU FORWARD OK: {arch}")
    del model

torch.cuda.synchronize()
print("TRILLIUM H100 PREFLIGHT PASSED")
PY

#!/bin/bash
#SBATCH --account=def-koohi
#SBATCH --job-name=gcbd-nlp-h100-check
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --gpus-per-node=1
#SBATCH --cpus-per-task=24
#SBATCH --time=00:20:00
#SBATCH --output=/scratch/koohi/RBN/logs/nlp/%x-%j.out
#SBATCH --mail-type=FAIL

set -euo pipefail

ROOT=/scratch/koohi/RBN
CODE="$ROOT/code/nlp"
VENV="$ROOT/envs/nlp/venv"

test -x "$VENV/bin/python"
test -f "$CODE/GCBD-NLP_RUN.py"

module --force purge
module load StdEnv/2023
module load gcc/12.3
module load arrow/25.0.0
module load cuda/12.6
module load python/3.11.5

source "$VENV/bin/activate"

export PYTHONPATH="$CODE"
export HF_HOME="$ROOT/cache/nlp/downloads"
export XDG_CACHE_HOME="$ROOT/cache/nlp/runtime"
export TRITON_CACHE_DIR="$ROOT/cache/nlp/runtime/triton/$SLURM_JOB_ID"
export TOKENIZERS_PARALLELISM=false
export OMP_NUM_THREADS=8
export MKL_NUM_THREADS=8

mkdir -p "$HF_HOME" "$XDG_CACHE_HOME" "$TRITON_CACHE_DIR"

cd "$CODE"

echo "======================================"
echo "GCBD NLP H100 PREFLIGHT"
echo "======================================"

echo "Host: $(hostname)"
echo "Job: $SLURM_JOB_ID"
echo "CPUs: $SLURM_CPUS_PER_TASK"
echo "Python: $(which python)"

nvidia-smi

python -u - <<'PY'
import importlib.util
import sys
import torch
import transformers
import datasets
import accelerate
import sklearn

print("Python:", sys.version)
print("PyTorch:", torch.__version__)
print("CUDA runtime:", torch.version.cuda)
print("Transformers:", transformers.__version__)
print("Datasets:", datasets.__version__)
print("Accelerate:", accelerate.__version__)
print("Scikit-learn:", sklearn.__version__)

# Import the actual GCBD NLP runner.
spec = importlib.util.spec_from_file_location(
    "gcbd_nlp_runner",
    "/scratch/koohi/RBN/code/nlp/GCBD-NLP_RUN.py"
)

runner = importlib.util.module_from_spec(spec)
spec.loader.exec_module(runner)

print("NLP runner import: PASS")
print("NLP scenarios:", len(runner.SCENARIOS))

# Actual H100 validation.
assert torch.cuda.is_available(), "CUDA unavailable"

device = torch.device("cuda:0")

print("GPU:", torch.cuda.get_device_name(0))

props = torch.cuda.get_device_properties(0)

print("GPU memory:", round(props.total_memory / 1024**3, 2), "GiB")
print("Compute capability:", torch.cuda.get_device_capability(0))

assert torch.cuda.is_bf16_supported(), "BF16 unavailable"

print("BF16 support: PASS")

# BF16 forward and backward test.
model = torch.nn.Sequential(
    torch.nn.Linear(1024, 2048),
    torch.nn.GELU(),
    torch.nn.Linear(2048, 1024)
).to(device)

optimizer = torch.optim.AdamW(model.parameters(), lr=1e-4)

x = torch.randn(32, 1024, device=device)
target = torch.randn(32, 1024, device=device)

optimizer.zero_grad(set_to_none=True)

with torch.autocast(
    device_type="cuda",
    dtype=torch.bfloat16
):
    output = model(x)
    loss = torch.nn.functional.mse_loss(
        output.float(),
        target
    )

loss.backward()
optimizer.step()

torch.cuda.synchronize()

assert torch.isfinite(loss), "Invalid training loss"

print("BF16 forward: PASS")
print("BF16 backward: PASS")
print("Optimizer step: PASS")
print("Training loss:", loss.item())

print(
    "Peak GPU memory:",
    round(torch.cuda.max_memory_allocated() / 1024**3, 3),
    "GiB"
)

print("======================================")
print("TRILLIUM NLP H100 PREFLIGHT PASSED")
print("======================================")
PY
